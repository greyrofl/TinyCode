{
  "name": "tinycode-cli",
  "version": "0.7.1",
  "description": "A lightweight local-first terminal coding agent for capable GGUF models via llama.cpp, Ollama, and compatible APIs",
  "type": "module",
  "bin": {
    "tinycode": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "promt.md",
    "compact.md",
    "README.md",
    "README_RU.md",
    "LICENSE",
    "docs",
    "data"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greyrofl/TinyCode.git"
  },
  "homepage": "https://github.com/greyrofl/TinyCode#readme",
  "bugs": {
    "url": "https://github.com/greyrofl/TinyCode/issues"
  },
  "author": "greyrofl",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js",
    "smoke": "tsx scripts/smoke.ts && tsx scripts/features-smoke.ts && tsx scripts/history-smoke.ts && tsx scripts/context-flow-smoke.ts && tsx scripts/tool-output-smoke.ts && tsx scripts/engines-smoke.ts",
    "smoke:tui": "tsx scripts/tui-smoke.ts",
    "mock": "node scripts/mock-ollama.mjs",
    "data:efficiency": "node scripts/collect-model-efficiency.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run smoke"
  },
  "keywords": [
    "cli",
    "ai",
    "ai-agent",
    "local-llm",
    "llama-cpp",
    "ollama",
    "gguf",
    "coding-agent",
    "terminal-ui",
    "speculative-decoding",
    "mcp",
    "openai-compatible",
    "qwen",
    "gemma"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
